# Dependencies
/node_modules

# Build output
/dist
/build

# Local env files
.env
.env.local
.env*.local

# Misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript
*.tsbuildinfo

# Vercel
.vercel

# Local test harness (regenerated on demand, not part of the app)
/.testing

# Report artifacts: the PDF and the submission archive are deliverables,
