/report/*.zip

# Single-file build (npm run build:standalone)
/standalone

# Standalone downloadable build
/download

# Submission archives ARE committed on purpose: the marker downloads them
# straight from the repository, so they must not be ignored.
# (Older archives superseded by a rebuild are pruned by hand.)
