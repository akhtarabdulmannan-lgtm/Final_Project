{
  "name": "vectisx-currency-converter",
  "version": "1.0.0",
  "private": true,
  "description": "Currency converter and exchange-rate dashboard built with React, Vite and the Frankfurter/open.er-api REST APIs.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/copy-404.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:links": "node scripts/check-links.mjs",
    "build:web": "vite build && node scripts/copy-404.mjs",
    "build:standalone": "vite build --config vite.config.standalone.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "domino": "^2.1.9",
    "happy-dom": "^21.0.4",
    "jsdom": "^31.0.1",
    "linkedom": "^0.18.15",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
