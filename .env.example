# ---------------------------------------------------------------------------
# Supabase (public values — safe to ship to the browser, protected by RLS)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://fbstwoqqhlaafarwcqiu.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Exchange-rate proxy (optional) — Vercel environment variables only.
#
# These are read by the serverless function in api/rates.ts. They are NOT
# prefixed with VITE_, so Vite never inlines them into the browser bundle.
# With none of them set, the function uses the public keyless endpoint and the
# app behaves exactly as it does with no proxy at all.
# ---------------------------------------------------------------------------
# Upstream JSON endpoint the function should call.
# FX_API_URL=https://open.er-api.com/v6/latest/USD
# Key for a paid/keyed provider. Leave unset for public endpoints.
# FX_API_KEY=
# Query-string parameter the key is sent as.
# FX_API_KEY_PARAM=api_key
